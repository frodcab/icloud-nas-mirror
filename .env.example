# Copy to `.env` next to compose.yml. NEVER commit real values.
# Secrets (Apple password, panel password, SMTP password) do NOT go here: put them in ./data/secrets.env
#   ICLOUD_PASSWORD=...        your normal Apple ID password (app-specific passwords do not work)
#   GUI_PASS=...               first password of the web panel (use a long one; you can change it later from the panel)
#   SMTP_PASSWORD=...          optional, for e-mail notifications
# Then:  chmod 600 data/secrets.env

# --- Apple account (required) ---
ICLOUD_USERNAME=your-apple-id@example.com
# true only for mainland-China iCloud accounts
ICLOUD_CHINA=false

# --- Where things live on your machine ---
DATA_DIR=./data          # sessions, state, trash, secrets.env
DRIVE_DIR=./drive        # kept equal to iCloud Drive
HOME_DIR=./home          # photos go to $HOME_DIR/Photos/iCloud/YYYY/MM
PUID=1000                # owner of the files written (run `id` on the host)
PGID=1000
TZ=UTC
WEB_PORT=8096

# --- Web panel ---
GUI_USER=admin
# Networks that are never locked out after failed logins; the rest are blocked progressively (15 min, 1 h, 24 h, 7 d)
AUTH_ALLOW_NETWORKS=192.168.0.0/16
# AUTH_DENY_NETWORKS=
# AUTH_ONLY_NETWORKS=      # if set, only these can log in (e.g. home + VPN)
PUBLIC_URL=http://localhost:8096

# --- First run: leave both on until the logs look right, then set to false ---
DRY_RUN=true             # iCloud Drive: only logs what it would do
PHOTOS_DRY_RUN=true      # iCloud Photos: only logs what it would do

# --- iCloud Drive ---
# Comma-separated folders of iCloud Drive; empty = the whole Drive. Example: Documents,Desktop/Work
SYNC_FOLDERS=
SYNC_INTERVAL_MIN=45
SYNC_APPS=true           # copy Pages/Numbers/Keynote... iCloud -> disk (one way)
HEIC_TO_JPG=true         # create photo.jpg next to each photo.heic (the HEIC is never touched)
CONFIRM_DELETES_OVER=5   # more deletions than this in one run wait for your confirmation in the panel
TRASH_DAYS=30

# --- iCloud Photos ---
SYNC_PHOTOS=true
PHOTOS_HIDDEN=true       # download hidden photos too
# Folder (relative to HOME_DIR) for hidden photos; empty = Photos/iCloud/Álbumes/Oculto
PHOTOS_HIDDEN_DIR=
PHOTOS_INTERVAL_MIN=240
# Per-run limits, so Apple does not throttle or lock your account
PHOTOS_MAX_DOWNLOADS=1000
PHOTOS_MAX_GB=10
PHOTOS_MAX_UPLOADS=200
PHOTOS_MAX_DELETES=200

# --- E-mail notifications (optional) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# NOTIFY_EMAIL_TO=
